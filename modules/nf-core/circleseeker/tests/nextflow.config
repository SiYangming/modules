// Fixtures live on SiYangming/test-datasets@circleseeker-testdata until an
// nf-core/test-datasets PR is opened/merged after user review.
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/SiYangming/test-datasets/circleseeker-testdata/data/'
}

// --init (tini) reaps leftover CircleSeeker child processes so Docker exits
// after the script finishes; without it nf-test can hang for hours.
docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g) --platform=linux/amd64 --init'
}

process {
    withLabel: process_high {
        cpus   = 2
        memory = '6.GB'
        time   = '30.m'
    }
    withName: CIRCLESEEKER {
        cpus   = 2
        memory = '6.GB'
        time   = '30.m'
    }
}
